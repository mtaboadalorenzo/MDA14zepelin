# Ejemplo de secrets. NO se sube con valores reales.
# En Streamlit Cloud: App settings → Secrets, y pegar esto con los valores de cada app.

OPENAI_API_KEY = "sk-..."
VERSION = "base"            # base | equipo1 | equipo2 | equipo3 | equipo4 | referencia
CLAVE_ZEPELIN = "elige-una-clave"
OPENAI_MODEL = "gpt-4o-mini" # un modelo pequeño y barato, el mismo en las 6 apps

# Opcionales
